# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python byte-code & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Local IDE and AI tool configurations (contain machine-specific settings/paths)
.claude/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment variables & secrets (API keys, credentials)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build and distribution artifacts
build/
dist/
*.egg-info/

# Logs
*.log

